  m_text: "\uBCC4\uB3C4 UI \uC5D0\uC14B \uC5C6\uC774 <b>Unity \uBE4C\uD2B8\uC778
    UGUI\uB9CC\uC73C\uB85C</b> \uB370\uC2A4\uD06C\uD1B1 OS\uC640 \uAC19\uC740 \uCC3D
    \uAE30\uBC18 UI\uB97C \uAD6C\uD604\uD55C \uD504\uB808\uC784\uC6CC\uD06C \uC0D8\uD50C\uC785\uB2C8\uB2E4.
    \uCC3D\uC758 \uC0DD\uC131\xB7\uC774\uB3D9\xB7\uB9AC\uC0AC\uC774\uC988\xB7\uCD5C\uB300\uD654/\uCD5C\uC18C\uD654/\uBCF5\uC6D0\uC740
    \uBB3C\uB860, \uC624\uBE0C\uC81D\uD2B8 \uD480\uB9C1\xB7z-\uC21C\uC11C \uAD00\uB9AC\xB7DPI
    \uC2A4\uCF00\uC77C\uB9C1\xB7\uC5D0\uB514\uD130 \uB3C4\uAD6C\xB7CI/CD\uAE4C\uC9C0
    \uAC16\uCDB0 <b>\uC7AC\uC0AC\uC6A9 \uAC00\uB2A5\uD55C \uB77C\uC774\uBE0C\uB7EC\uB9AC</b>
    \uC218\uC900\uC744 \uBAA9\uD45C\uB85C \uD588\uC2B5\uB2C8\uB2E4. \uCF54\uB4DC
    \uD55C \uC904\uB85C \uCC3D\uC744 \uB744\uC6C1\uB2C8\uB2E4."
  m_isRightToLeft: 0
